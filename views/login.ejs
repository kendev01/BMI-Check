<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Log in - BMI Check' }) %>
<body class="min-h-screen bg-slate-950 text-slate-200 px-4 py-6">
  <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(60rem_40rem_at_30%_-10%,rgba(16,185,129,0.12),transparent)]"></div>

  <div class="relative">
    <%- include('partials/nav') %>

    <main class="w-full max-w-4xl mx-auto">
      <div class="grid lg:grid-cols-2 rounded-3xl overflow-hidden ring-1 ring-white/10 bg-slate-900/60 shadow-2xl">

        <div class="p-7 sm:p-10 order-2 lg:order-1">
          <h1 class="text-2xl font-extrabold tracking-tight text-white">Welcome back</h1>
          <p class="text-sm text-slate-400 mt-1.5">Pick up where you left off.</p>

          <form method="POST" action="/login" novalidate class="mt-7 space-y-5">
            <% if (errors.form) { %>
              <p class="flex items-start gap-2 text-sm text-red-300 bg-red-500/10 ring-1 ring-red-500/30 rounded-xl px-4 py-3">
                <span aria-hidden="true">&#9888;</span><span><%= errors.form %></span>
              </p>
            <% } %>

            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email"
                placeholder="you@example.com" value="<%= values.email || '' %>"
                class="w-full rounded-xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-400/70 focus:border-emerald-400/50 transition" />
            </div>

            <div>
              <div class="flex items-baseline justify-between mb-1.5">
                <label for="password" class="block text-sm font-medium text-slate-300">Password</label>
                <a href="/forgot" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300">Forgot?</a>
              </div>
              <input type="password" id="password" name="password" required autocomplete="current-password"
                placeholder="Your password"
                class="w-full rounded-xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-400/70 focus:border-emerald-400/50 transition" />
            </div>

            <button type="submit"
              class="w-full bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold rounded-xl px-4 py-3.5 shadow-lg shadow-emerald-500/20 transition-colors">
              Log in
            </button>
          </form>

          <p class="text-sm text-slate-500 mt-6">
            New here?
            <a href="/signup" class="text-emerald-400 hover:text-emerald-300 font-semibold">Create an account</a>
          </p>
        </div>

        <aside class="relative hidden lg:flex flex-col justify-between p-9 order-1 lg:order-2 bg-gradient-to-bl from-emerald-500/15 via-slate-900 to-slate-900">
          <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-emerald-400">Keep going</p>
            <h2 class="text-3xl font-extrabold text-white mt-3 leading-tight">
              Every day<br />you log counts.
            </h2>
            <p class="text-sm text-slate-400 mt-4 max-w-xs">
              Your calorie target updates automatically whenever your numbers change.
            </p>
          </div>

          <div class="flex items-end justify-center gap-6 h-64 mt-6">
            <div class="h-full w-24 opacity-70">
              <%- include('partials/figure', { fig: heroFigures.current, label: 'Current build' }) %>
            </div>
            <div class="h-full w-24">
              <%- include('partials/figure', { fig: heroFigures.goal, label: 'Goal build' }) %>
            </div>
          </div>
        </aside>
      </div>
    </main>

    <%- include('partials/footer') %>
  </div>
  <script src="/js/passwordToggle.js"></script>
</body>
</html>
