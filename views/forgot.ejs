<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Reset password - BMI Check' }) %>
<body class="min-h-screen bg-slate-950 text-slate-200 px-4 py-6">
  <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(60rem_40rem_at_50%_-10%,rgba(16,185,129,0.12),transparent)]"></div>

  <div class="relative">
    <%- include('partials/nav') %>

    <main class="w-full max-w-md mx-auto">
      <div class="rounded-3xl bg-slate-900/60 ring-1 ring-white/10 shadow-2xl p-7 sm:p-9">
        <% if (sent) { %>
          <div class="text-center">
            <span class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-emerald-400/15 text-emerald-400 text-2xl">&#10003;</span>
            <h1 class="text-2xl font-extrabold tracking-tight text-white mt-4">Check your inbox</h1>
            <p class="text-sm text-slate-400 mt-3">
              If an account exists for <span class="text-slate-200 font-semibold"><%= values.email %></span>,
              we've sent a link to reset your password. It expires in an hour.
            </p>

            <% if (previewUrl || fallbackUrl) { %>
              <div class="mt-6 text-left rounded-xl bg-amber-400/10 ring-1 ring-amber-400/30 p-4">
                <p class="text-xs font-bold uppercase tracking-widest text-amber-300">Development mode</p>
                <% if (previewUrl) { %>
                  <p class="text-xs text-amber-200/80 mt-1.5">
                    No SMTP server is configured, so the mail went to a test inbox.
                  </p>
                  <a href="<%= previewUrl %>" target="_blank" rel="noopener"
                     class="text-xs font-semibold text-amber-300 hover:text-amber-200 underline break-all mt-2 inline-block">
                    Open the sent email
                  </a>
                <% } else { %>
                  <p class="text-xs text-amber-200/80 mt-1.5">
                    No mail server is reachable, so the email was written to <code>./outbox</code>.
                    Use this link directly:
                  </p>
                  <a href="<%= fallbackUrl %>"
                     class="text-xs font-semibold text-amber-300 hover:text-amber-200 underline break-all mt-2 inline-block">
                    <%= fallbackUrl %>
                  </a>
                <% } %>
              </div>
            <% } %>

            <a href="/login" class="inline-block mt-7 text-sm font-semibold text-emerald-400 hover:text-emerald-300">
              Back to log in
            </a>
          </div>
        <% } else { %>
          <h1 class="text-2xl font-extrabold tracking-tight text-white">Forgot your password?</h1>
          <p class="text-sm text-slate-400 mt-1.5">
            Enter your email and we'll send you a link to set a new one.
          </p>

          <form method="POST" action="/forgot" novalidate class="mt-7 space-y-5">
            <div>
              <label for="email" class="block text-sm font-medium text-slate-300 mb-1.5">Email</label>
              <input type="email" id="email" name="email" required autocomplete="email"
                placeholder="you@example.com" value="<%= values.email || '' %>"
                class="w-full rounded-xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-400/70 focus:border-emerald-400/50 transition" />
              <% if (errors.email) { %><p class="text-xs text-red-400 mt-1.5"><%= errors.email %></p><% } %>
            </div>

            <button type="submit"
              class="w-full bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold rounded-xl px-4 py-3.5 shadow-lg shadow-emerald-500/20 transition-colors">
              Send reset link
            </button>
          </form>

          <p class="text-sm text-slate-500 mt-6">
            Remembered it? <a href="/login" class="text-emerald-400 hover:text-emerald-300 font-semibold">Log in</a>
          </p>
        <% } %>
      </div>
    </main>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
