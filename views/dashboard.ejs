<!DOCTYPE html>
<html lang="en">
<%- include('partials/head', { title: 'Tracker - BMI Check' }) %>
<body class="min-h-screen bg-slate-950 text-slate-200 px-4 py-6">
  <div class="pointer-events-none fixed inset-0 bg-[radial-gradient(60rem_40rem_at_50%_-10%,rgba(16,185,129,0.1),transparent)]"></div>

  <div class="relative">
    <%- include('partials/nav') %>

    <main class="w-full max-w-3xl mx-auto space-y-5">

      <% if (!profile) { %>
        <section class="rounded-2xl bg-amber-400/10 ring-1 ring-amber-400/30 p-5 flex flex-wrap items-center justify-between gap-3">
          <p class="text-sm text-amber-200">Run the calculator once to set your daily calorie target.</p>
          <a href="/" class="text-sm font-bold text-slate-950 bg-amber-300 hover:bg-amber-200 px-4 py-2 rounded-lg transition">
            Open calculator
          </a>
        </section>
      <% } %>

      <section class="rounded-3xl bg-slate-900/60 ring-1 ring-white/10 shadow-2xl p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
          <h1 class="text-lg font-bold text-white">Daily intake</h1>
          <form method="GET" action="/dashboard" class="flex items-center gap-2">
            <input type="date" name="date" value="<%= date %>" max="<%= today %>"
              class="rounded-lg bg-slate-950/70 border border-white/10 px-3 py-2 text-sm text-slate-200 focus:outline-none focus:ring-2 focus:ring-emerald-400/70" />
            <button type="submit" class="text-sm px-3 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 font-medium transition">Show</button>
          </form>
        </div>

        <div class="flex flex-wrap items-start gap-6 sm:gap-10">
          <% if (figure) { %>
            <div class="h-40 aspect-[200/420] shrink-0 hidden sm:block">
              <%- include('partials/figure', { fig: figure, label: 'Your current build' }) %>
            </div>
          <% } %>

          <div class="flex-1 min-w-[15rem]">
            <div class="flex flex-wrap items-end gap-x-8 gap-y-4">
              <div>
                <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Eaten</p>
                <p class="text-4xl font-extrabold text-white tabular-nums mt-1"><%= total.toLocaleString() %></p>
              </div>
              <% if (target !== null) { %>
                <div>
                  <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Target</p>
                  <p class="text-4xl font-extrabold text-emerald-400 tabular-nums mt-1"><%= target.toLocaleString() %></p>
                </div>
                <div>
                  <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">
                    <%= overTarget ? 'Over by' : 'Left' %>
                  </p>
                  <p class="text-4xl font-extrabold tabular-nums mt-1 <%= overTarget ? 'text-red-400' : 'text-slate-200' %>">
                    <%= Math.abs(remaining).toLocaleString() %>
                  </p>
                </div>
              <% } %>
            </div>

            <% if (target !== null) { %>
              <div class="mt-6">
                <div class="h-3 rounded-full bg-white/5 ring-1 ring-white/10 overflow-hidden">
                  <div class="h-full rounded-full transition-all <%= overTarget ? 'bg-red-400' : 'bg-gradient-to-r from-emerald-500 to-emerald-300' %>"
                       style="width: <%= percentOfTarget %>%;"></div>
                </div>
                <p class="text-xs text-slate-500 mt-2"><%= percentOfTarget %>% of your daily target</p>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <% if (goal && goal.progress) { %>
        <section class="rounded-3xl bg-slate-900/60 ring-1 ring-white/10 shadow-2xl p-6 sm:p-7">
          <div class="flex flex-wrap items-baseline justify-between gap-2 mb-4">
            <h2 class="text-base font-bold text-white">Goal window</h2>
            <span class="text-xs text-slate-500 tabular-nums"><%= goal.startDate %> &rarr; <%= goal.targetDate %></span>
          </div>

          <div class="h-2.5 rounded-full bg-white/5 ring-1 ring-white/10 overflow-hidden">
            <div class="h-full rounded-full bg-gradient-to-r from-emerald-500 to-emerald-300"
                 style="width: <%= goal.progress.percent %>%;"></div>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-2 mt-2.5">
            <p class="text-xs text-slate-500">
              <% if (goal.progress.overdue) { %>
                Target date passed <%= Math.abs(goal.progress.remainingDays) %> days ago &mdash; recalculate to set a new one.
              <% } else { %>
                Day <%= goal.progress.elapsedDays %> of <%= goal.progress.totalDays %> &mdash;
                <span class="text-emerald-400 font-semibold"><%= goal.progress.remainingDays %> days left</span>
              <% } %>
            </p>
            <a href="/calendar" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300">Open calendar &rarr;</a>
          </div>

          <% if (goal.assessment && goal.assessment.verdict === 'too-fast') { %>
            <p class="text-xs text-amber-300 bg-amber-400/10 ring-1 ring-amber-400/30 rounded-lg px-3.5 py-2.5 mt-4">
              That date needs <%= goal.assessment.requiredRate %> kg/week, above the
              <%= goal.assessment.safeMax %> kg/week considered safe. Consider allowing more time.
            </p>
          <% } %>
        </section>
      <% } %>

      <section class="rounded-3xl bg-slate-900/60 ring-1 ring-white/10 shadow-2xl p-6 sm:p-8">
        <h2 class="text-lg font-bold text-white mb-5">Add an entry</h2>

        <form method="POST" action="/entries" novalidate class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-3">
          <input type="hidden" name="entryDate" value="<%= date %>" />

          <div>
            <label for="description" class="sr-only">What did you eat?</label>
            <input type="text" id="description" name="description" maxlength="120" required
              placeholder="e.g. Chicken rice bowl" value="<%= values.description || '' %>"
              class="w-full rounded-xl bg-slate-950/70 border border-white/10 px-4 py-3 text-slate-100 placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-400/70 focus:border-emerald-400/50 transition" />
            <% if (errors.description) { %><p class="text-xs text-red-400 mt-1.5"><%= errors.description %></p><% } %>
          </div>

          <div>
            <label for="calories" class="sr-only">Calories</label>
            <div class="relative">
              <input type="number" id="calories" name="calories" min="0" max="10000" step="1" required
                placeholder="450" value="<%= values.calories || '' %>"
                class="w-full sm:w-36 rounded-xl bg-slate-950/70 border border-white/10 px-4 py-3 pr-14 text-slate-100 tabular-nums placeholder:text-slate-600 focus:outline-none focus:ring-2 focus:ring-emerald-400/70 focus:border-emerald-400/50 transition" />
              <span class="absolute inset-y-0 right-3.5 flex items-center text-sm text-slate-500 pointer-events-none">kcal</span>
            </div>
            <% if (errors.calories) { %><p class="text-xs text-red-400 mt-1.5"><%= errors.calories %></p><% } %>
          </div>

          <button type="submit"
            class="bg-emerald-400 hover:bg-emerald-300 text-slate-950 font-bold rounded-xl px-6 py-3 shadow-lg shadow-emerald-500/20 transition-colors">
            Add
          </button>
        </form>

        <% if (items.length) { %>
          <ul class="divide-y divide-white/5 mt-6">
            <% items.forEach((item) => { %>
              <li class="py-3">
                <% if (editingId === item.id) { %>
                  <form method="POST" action="/entries/<%= item.id %>"
                        class="grid grid-cols-1 sm:grid-cols-[1fr_auto_auto_auto] gap-2 items-start">
                    <div>
                      <label for="edit-desc-<%= item.id %>" class="sr-only">Description</label>
                      <input type="text" id="edit-desc-<%= item.id %>" name="description" maxlength="120" required
                        value="<%= values.description !== undefined ? values.description : item.description %>"
                        class="w-full rounded-lg bg-slate-950/70 border border-emerald-400/40 px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-400/70" />
                      <% if (errors.description) { %><p class="text-xs text-red-400 mt-1"><%= errors.description %></p><% } %>
                    </div>
                    <div>
                      <label for="edit-cal-<%= item.id %>" class="sr-only">Calories</label>
                      <input type="number" id="edit-cal-<%= item.id %>" name="calories" min="0" max="10000" step="1" required
                        value="<%= values.calories !== undefined ? values.calories : item.calories %>"
                        class="w-full sm:w-28 rounded-lg bg-slate-950/70 border border-emerald-400/40 px-3 py-2 text-sm text-slate-100 tabular-nums focus:outline-none focus:ring-2 focus:ring-emerald-400/70" />
                      <% if (errors.calories) { %><p class="text-xs text-red-400 mt-1"><%= errors.calories %></p><% } %>
                    </div>
                    <button type="submit"
                      class="bg-emerald-400 hover:bg-emerald-300 text-slate-950 text-sm font-bold rounded-lg px-4 py-2 transition-colors">
                      Save
                    </button>
                    <a href="/dashboard?date=<%= date %>"
                       class="text-sm text-slate-400 hover:text-white px-3 py-2 rounded-lg hover:bg-white/5 transition text-center">
                      Cancel
                    </a>
                  </form>
                <% } else { %>
                  <div class="flex items-center justify-between gap-3">
                    <span class="text-sm text-slate-300 min-w-0 break-words"><%= item.description %></span>
                    <span class="flex items-center gap-3 shrink-0">
                      <span class="text-sm font-bold text-slate-200 tabular-nums"><%= item.calories.toLocaleString() %></span>
                      <a href="/dashboard?date=<%= date %>&edit=<%= item.id %>"
                         class="text-xs font-semibold text-slate-500 hover:text-emerald-400 transition px-2 py-1 rounded">Edit</a>
                      <form method="POST" action="/entries/<%= item.id %>/delete" class="inline">
                        <input type="hidden" name="entryDate" value="<%= date %>" />
                        <button type="submit" aria-label="Delete entry"
                          class="text-slate-600 hover:text-red-400 transition-colors text-xl leading-none">&times;</button>
                      </form>
                    </span>
                  </div>
                <% } %>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="text-sm text-slate-600 text-center py-8">Nothing logged for this day yet.</p>
        <% } %>
      </section>

      <% if (history.length) { %>
        <section class="rounded-3xl bg-slate-900/60 ring-1 ring-white/10 shadow-2xl p-6 sm:p-8">
          <h2 class="text-lg font-bold text-white mb-4">Recent days</h2>
          <ul class="divide-y divide-white/5">
            <% history.forEach((day) => { %>
              <li class="flex items-center justify-between py-3">
                <a href="/dashboard?date=<%= day.entry_date %>"
                   class="text-sm text-slate-400 hover:text-emerald-400 tabular-nums transition"><%= day.entry_date %></a>
                <span class="text-sm text-slate-400 tabular-nums">
                  <%= day.total.toLocaleString() %> kcal
                  <% if (target !== null) { %>
                    <span class="<%= day.total > target ? 'text-red-400' : 'text-emerald-400' %> font-semibold ml-1">
                      <%= day.total > target ? '+' : '' %><%= (day.total - target).toLocaleString() %>
                    </span>
                  <% } %>
                </span>
              </li>
            <% }) %>
          </ul>
        </section>
      <% } %>
    </main>

    <%- include('partials/footer') %>
  </div>
</body>
</html>
